# URL of the case-study prototype video, served from object storage.
# Cloudflare Pages rejects single files over 25 MiB, so the video is not
# committed to the repo or included in the build output.
#
# Cloudflare R2:  https://<bucket>.<account>.r2.dev/csi-prototype.mp4
#                 (or a custom domain bound to the bucket)
# AWS S3:         https://<bucket>.s3.<region>.amazonaws.com/csi-prototype.mp4
#                 (or a CloudFront distribution in front of it)
#
# Leave unset locally to fall back to public/videos/csi-prototype.mov
VITE_CSI_VIDEO_URL=
